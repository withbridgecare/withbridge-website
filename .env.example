# 실제 값은 .env 에만 넣고 커밋하지 마세요. 이 파일은 어떤 키가 필요한지 보여주는 템플릿입니다.

# ── 브라우저용 공개 설정 ───────────────────────────────────────────────
# scripts/build-env.mjs 가 이 값들로 js/env.js(window.WB_ENV)를 만듭니다.
# 로컬은 .env, 배포는 Vercel → Project Settings → Environment Variables 에 같은 이름으로 등록하세요.
# Next.js 화면은 next.config.ts 가 이 값들을 NEXT_PUBLIC_* 이름으로 넘겨 쓰므로 따로 등록할 필요가 없습니다.
# 공개되는 값만 둡니다(anon/publishable key 는 브라우저에 노출돼도 되는 키). 비밀 키는 여기 두지 마세요.
WB_ENV_NAME=production          # production | development
TELEGRAM_BOT_USERNAME=          # 매니저 [텔레그램 알림 연결] 봇 아이디('@' 없이). 비우면 withbridge_alert_bot(운영).
                                # 개발 환경은 개발 Supabase 의 TELEGRAM_BOT_TOKEN 과 같은 봇 아이디를 넣으세요.
SUPABASE_URL=                   # 예: https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=              # Supabase → Project Settings → API → anon / publishable key

# ── Supabase Edge Function Secrets 참고용 ──
# PORTONE_STORE_ID / PORTONE_CHANNEL_KEY 는 공개 식별자지만 결제 설정을 한곳에서 관리하기 위해 Edge Function이 전달합니다.
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=             # 테스트/실결제 모드는 PortOne에서 발급한 채널 키로 선택
PORTONE_API_SECRET=
PORTONE_VIRTUAL_ACCOUNT_CHANNEL_KEY=
PORTONE_WEBHOOK_SECRET=

# 신규 케어 신청 접수 시 매니저 운영 채널로 보내는 텔레그램 알림
# (supabase/functions/issue-virtual-account, portone-webhook, _shared/telegram.ts 참고)
# 이 값들은 .env 가 아니라 Supabase Edge Function Secrets 로 등록합니다 — 아래 "supabase secrets set"
# 가이드대로 터미널에서 설정하세요(.env 는 로컬 개발용 참고 템플릿일 뿐, Edge Function 런타임은 이 파일을
# 읽지 않습니다).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 신규 "케어 매니저 지원서"(manager-apply.html) 접수 알림을 받을 전용 채팅방 id.
# (supabase/functions/submit-manager-application, _shared/telegram.ts 참고. 봇 토큰은 TELEGRAM_BOT_TOKEN 공유)
TELEGRAM_MANAGER_CHAT_ID=
# 운영 사이트 주소 — 텔레그램 알림 링크(Edge Function)와 검색엔진 사이트맵·공유 미리보기(Next.js)에 함께 쓰입니다.
# 예: https://www.withbridge.kr  (비우면 Next.js 는 lib/config.ts 의 기본값을 씀)
# 알림 메시지의 "매니저 마이페이지에서 수락하기" 링크에 쓸 배포 도메인(예: https://withbridgecare.com).
# 비워 두면 상대 경로("mypage-manager.html")로만 표시되어 클릭해도 안 열릴 수 있습니다.
SITE_URL=

# 케어 매니저 지원서(manager-apply.html) 도배/봇 방지 — Cloudflare Turnstile.
# 필요하면 Cloudflare 대시보드 > Turnstile 위젯의 공개 Site Key를 이 변수로 덮어씁니다.
# 비어 있으면 현재 페이지에 설정된 공개 Site Key를 사용합니다.
# Secret Key는 브라우저에 노출하지 말고 Supabase Edge Function Secrets에 등록합니다.
# (supabase/functions/submit-manager-application 참고)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 동행 신청 7단계 상태 변경 시 고객에게 보내는 카카오 알림톡(Solapi).
# (supabase/functions/send-status-alimtalk, _shared/solapi.ts, sql/care_status_alimtalk_webhook.sql 참고)
# 이 값들도 .env 가 아니라 Supabase Edge Function Secrets 로 등록합니다("supabase secrets set ...").
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=
SOLAPI_PF_ID=
SOLAPI_TEMPLATE_ORDER_RECEIVED=
SOLAPI_TEMPLATE_MANAGER_ASSIGNED=
SOLAPI_TEMPLATE_DEPARTED=
SOLAPI_TEMPLATE_ARRIVED_HOSPITAL=
SOLAPI_TEMPLATE_TREATMENT_COMPLETED=
SOLAPI_TEMPLATE_RETURNING=
SOLAPI_TEMPLATE_CARE_FINISHED=
# DB 트리거(pg_net)가 이 함수를 호출할 때 보내는 공유 비밀값 — Vault의 'alimtalk_webhook_secret'과
# 반드시 같은 값이어야 합니다(sql/care_status_alimtalk_webhook.sql 상단 설정 가이드 참고).
ALIMTALK_WEBHOOK_SECRET=

# Resend 이메일 발송 공통 설정 — 48시간 미매칭 자동 취소 환불 안내 메일(cancel-expired-applications)과
# 제휴 문의 접수 알림 메일(notify-partner-inquiry) 둘 다 이 값을 공유합니다.
# (supabase/functions/_shared/resend.ts 참고) 이 값들도 .env 가 아니라 Supabase Edge Function Secrets 로
# 등록합니다("supabase secrets set ...").
RESEND_API_KEY=
# Resend 콘솔에서 DNS 도메인 인증까지 끝낸 발신 주소(예: '위드브릿지 <no-reply@withbridge.co.kr>').
RESEND_FROM_EMAIL=

# partner.html 제휴 문의 신규 접수 시 대표님 이메일로 보내는 알림 메일.
# (supabase/functions/notify-partner-inquiry, sql/partner_inquiry_notify_webhook.sql 참고)
# DB 트리거(pg_net)가 이 함수를 호출할 때 보내는 공유 비밀값 — Vault의 'partner_inquiry_webhook_secret'과
# 반드시 같은 값이어야 합니다(sql/partner_inquiry_notify_webhook.sql 상단 설정 가이드 참고).
PARTNER_INQUIRY_WEBHOOK_SECRET=
# 알림을 받을 주소 — 비워 두면 notify-partner-inquiry/index.ts 의 기본값(withbridge.care@outlook.kr)을 씁니다.
PARTNER_INQUIRY_NOTIFY_EMAIL=

# AI 케어 리포트 초안 생성(mypage-manager.html '케어 리포트 작성' 모달의 [AI 리포트 초안 생성] 버튼).
# (supabase/functions/generate-care-report 참고) 이 값도 .env 가 아니라 Supabase Edge Function Secrets 로
# 등록합니다("supabase secrets set OPENAI_API_KEY=..."). 둘 중 하나만 있으면 되고, OPENAI_API_KEY 가
# 있으면 그걸 우선 씁니다(gpt-4o-mini). 둘 다 비워 두면 AI 초안 생성만 비활성화되고 리포트 제출(직접
# 작성)은 그대로 동작합니다.
OPENAI_API_KEY=
GEMINI_API_KEY=
