# 실제 값은 .env 에만 넣고 커밋하지 마세요. 이 파일은 어떤 키가 필요한지 보여주는 템플릿입니다.
PORTONE_STORE_ID=
PORTONE_API_SECRET=
PORTONE_VIRTUAL_ACCOUNT_CHANNEL_KEY=
PORTONE_WEBHOOK_SECRET=

# 신규 케어 신청 접수 시 매니저 운영 채널로 보내는 텔레그램 알림
# (supabase/functions/issue-virtual-account, portone-webhook, _shared/telegram.ts 참고)
# 이 값들은 .env 가 아니라 Supabase Edge Function Secrets 로 등록합니다 — 아래 "supabase secrets set"
# 가이드대로 터미널에서 설정하세요(.env 는 로컬 개발용 참고 템플릿일 뿐, Edge Function 런타임은 이 파일을
# 읽지 않습니다).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 신규 "케어 매니저 지원서"(manager-apply.html) 접수 알림을 받을 전용 채팅방 id.
# (supabase/functions/submit-manager-application, _shared/telegram.ts 참고. 봇 토큰은 TELEGRAM_BOT_TOKEN 공유)
TELEGRAM_MANAGER_CHAT_ID=
# 알림 메시지의 "매니저 마이페이지에서 수락하기" 링크에 쓸 배포 도메인(예: https://withbridgecare.com).
# 비워 두면 상대 경로("mypage-manager.html")로만 표시되어 클릭해도 안 열릴 수 있습니다.
SITE_URL=

# 케어 매니저 지원서(manager-apply.html) 도배/봇 방지 — Cloudflare Turnstile.
# Cloudflare 대시보드 > Turnstile 에서 위젯을 만들면 Site Key(공개, manager-apply.html 에 그대로
# 적음)와 Secret Key(비공개)를 받습니다. Secret Key만 여기(실은 Supabase Edge Function Secrets)에 등록합니다.
# (supabase/functions/submit-manager-application 참고)
TURNSTILE_SECRET_KEY=
